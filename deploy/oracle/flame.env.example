# Make the real one with: deploy/oracle/make-env.sh <domain>  (git ignores flame.env; deploy.sh uploads it, mode 600)
# Public name of the server; Caddy gets the HTTPS certificate for it. A DuckDNS name (like synergymatch.duckdns.org)
# or, without one: <ip with dashes>.sslip.io
DOMAIN=

# The whole site asks for this password (user name: flame). The regulation data is licensed for the hackathon only.
FLAME_PASSWORD=

# Claude (hackathon credits): new analyses, the enrich agent, the assistant and graph chat
CLAUDE_KEY=

# ElevenLabs: voice questions and spoken answers (optional)
ELEVENLABS_KEY=
ELEVENLABS_VOICE_ID=
